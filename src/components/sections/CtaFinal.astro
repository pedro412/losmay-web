---
/**
 * CTA final: banda marino con borde superior rojo de 6px, antes del footer.
 *
 * - "Cotizar por WhatsApp" abre WhatsApp con el mensaje de mayoreo de
 *   `site.ts` (`wa.mayoreo`).
 * - "Ver opciones de pedido" baja a las tarjetas por tonelaje (`#pedido`).
 *
 * Analytics (issue #12): el WhatsApp lleva `click_whatsapp` con
 * `ubicacion="cta_final"` (atributos de `track()`).
 *
 * El titular lleva el interlineado 0.92 del diseño. Con ese interlineado el
 * gancho del «¿», que baja de la línea base, toca la letra del renglón de
 * abajo (se leía «ÑECESITAS»), así que el «¿» sube 0.12em. El texto y el
 * nombre accesible del titular no cambian.
 *
 * En escritorio el texto y los botones van lado a lado; en móvil se apilan
 * (flex-wrap con las bases del diseño: 480px y 280px).
 */
import { ui, wa } from "../../data/site";
import { track } from "../../lib/analytics";
import Button from "../Button.astro";
---

<section
  aria-labelledby="cta-titulo"
  class="foco-sobre-marino border-t-6 border-rojo bg-marino py-[clamp(48px,7cqi,104px)] text-white page-gutter"
>
  <div class="flex flex-wrap items-center justify-between gap-x-12 gap-y-6 page-container">
    <div class="min-w-0 flex-[1_1_480px]">
      <h2 id="cta-titulo" class="m-0 display-heading text-cta">
        <span class="relative -top-[0.12em]">¿</span>Cuántas toneladas
        necesitas?
      </h2>
      <p class="mt-3 mb-0 text-[17px] text-marino-100">
        Mándanos tu pedido y te respondemos con cotización y fecha de entrega.
      </p>
    </div>

    <div class="flex max-w-[420px] flex-[1_1_280px] flex-col gap-2.5">
      <Button
        variant="whatsapp"
        size="lg"
        shape="lg"
        block
        external
        href={wa.mayoreo}
        {...track("click_whatsapp", { ubicacion: "cta_final" })}
      >
        {ui.cotizarWhatsApp}
      </Button>
      <Button variant="outline-claro" size="lg" shape="lg" block href="#pedido">
        Ver opciones de pedido
      </Button>
    </div>
  </div>
</section>
