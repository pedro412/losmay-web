---
/**
 * Sección "Para quién es" (`#para-quien`), docs/design/Main.dc.html.
 *
 * Cuatro tarjetas con ícono sobre cuadro marino (`paraQuien` en site.ts).
 *
 * - Debajo de 1024px: carrusel horizontal con `scroll-snap`. Cada tarjeta
 *   mide `min(260px, 78%)`, como en el diseño, y el carril se sale hasta los
 *   bordes de la pantalla (`-mx-gutter` + `px-gutter`), así que la
 *   siguiente tarjeta asoma cortada en el borde derecho: es la pista de que
 *   hay más. El `scroll-padding` alinea cada tarjeta con el texto de la
 *   sección al hacer snap. El carril mide exactamente el ancho de la sección,
 *   así que la página no gana scroll horizontal.
 * - Desde 1024px (`lg:`): las 4 en fila, en una cuadrícula de 4 columnas (a
 *   1440px quedan de ~311px, igual que el `flex: 1 0 260px` del diseño).
 *   Entre 760 y 1023px las 4 no caben a 260px, por eso ahí sigue el
 *   carrusel. TODO(diseño): validar el carrusel en 760–1023px, que el diseño
 *   no define.
 *
 * Las tarjetas no tienen nada enfocable, así que el carril lleva
 * `tabindex="0"` para poder desplazarlo con las flechas del teclado. Su
 * anillo de foco va por dentro en el carrusel, porque por fuera quedaría
 * fuera de la pantalla.
 */
import Icon from "../Icon.astro";
import SectionHeading from "../SectionHeading.astro";
import { paraQuien } from "../../data/site";

const tituloId = "pq-titulo";
---

<section
  id="para-quien"
  aria-labelledby={tituloId}
  class="bg-white section-pad"
>
  <div class="page-container">
    <SectionHeading
      eyebrow="Para quién es"
      title="Si compras cemento por volumen, esto es para ti."
      id={tituloId}
      tone="claro"
      titleClass="max-w-[820px]"
    />

    <div
      role="region"
      aria-labelledby={tituloId}
      tabindex="0"
      class="mt-8 flex snap-x snap-mandatory gap-3 overflow-x-auto overscroll-x-contain pb-2 max-lg:-mx-gutter max-lg:scroll-px-gutter max-lg:px-gutter max-lg:focus-visible:-outline-offset-3 lg:grid lg:snap-none lg:grid-cols-4 lg:overflow-visible lg:pb-0"
    >
      {paraQuien.map(({ icono, titulo, texto }) => (
        <article class="flex shrink-0 grow basis-[min(260px,78%)] snap-start flex-col gap-3 rounded-[14px] border border-borde p-6 lg:basis-auto">
          <div class="flex size-12 items-center justify-center rounded-xl bg-marino text-white">
            <Icon name={icono} size={24} strokeWidth={1.8} />
          </div>
          <h3 class="font-display text-[26px] leading-none font-bold text-marino uppercase">
            {titulo}
          </h3>
          <p class="text-base text-acero">{texto}</p>
        </article>
      ))}
    </div>
  </div>
</section>
