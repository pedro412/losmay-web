---
/**
 * "Por qué Los May" (fondo concreto): titular y cuatro tarjetas blancas en
 * una cuadrícula `auto-fit, minmax(150px, 1fr)`, como en el diseño.
 *
 * La primera tarjeta muestra una cifra (número de sucursales) en lugar de
 * ícono; la cifra va dentro del h3 para que se lea "2 Sucursales".
 *
 * Los textos salen de `beneficios` en src/data/site.ts. La promesa de
 * "inventario en tiempo real" sigue marcada ahí con TODO(cliente).
 */
import { beneficios } from "../../data/site";
import Icon from "../Icon.astro";
import SectionHeading from "../SectionHeading.astro";
import Texto from "../Texto.astro";
---

<section aria-labelledby="por-que-titulo" class="bg-concreto section-pad">
  <div class="page-container">
    <SectionHeading
      eyebrow="Por qué Los May"
      title="Material a tiempo, sin sorpresas."
      id="por-que-titulo"
      tone="concreto"
      titleClass="max-w-[820px]"
    />

    <ul
      role="list"
      class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-2.5"
    >
      {beneficios.map((beneficio) => (
        <li class="flex flex-col gap-2 rounded-2xl bg-white p-5">
          {"icono" in beneficio && (
            <Icon
              name={beneficio.icono}
              size={40}
              strokeWidth={1.8}
              class="text-rojo"
            />
          )}
          <h3 class="m-0 font-display text-[22px] leading-none font-extrabold text-marino uppercase">
            {"cifra" in beneficio && (
              <>
                <span class="mb-2 block text-[48px] leading-[0.9] text-rojo">
                  {beneficio.cifra}
                </span>{" "}
              </>
            )}
            {beneficio.titulo}
          </h3>
          <p class="m-0 text-[15px] text-acero">
            <Texto texto={beneficio.texto} />
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
