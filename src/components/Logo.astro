---
/**
 * Logo plano de Los May (docs/design/Marca.dc.html), en SVG inline.
 *
 * - `marino`: texto marino y trazo rojo #C8202A, sobre fondos claros.
 * - `blanco`: texto blanco y trazo #E0353C, sobre marino.
 *
 * Los textos ("LOS", "MAY" y "MATERIALES PARA CONSTRUCCIÓN") están convertidos
 * a paths desde Barlow Condensed 800 y Barlow 600, con el mismo kerning y
 * `textLength` del diseño, así que el logo no depende de que cargue la fuente.
 *
 * El ancho lo pone quien lo usa (p. ej. `class="w-[164px]"`); el alto sale
 * del viewBox (1100 × 480).
 */
interface Props {
  variant?: "marino" | "blanco";
  /** Texto accesible. Con `decorative` se oculta a lectores de pantalla. */
  label?: string;
  /** Úsalo cuando el texto ya está al lado (o en el `aria-label` del link). */
  decorative?: boolean;
  class?: string;
}

const {
  variant = "marino",
  label = "Los May Materiales para construcción",
  decorative = false,
  class: className,
} = Astro.props;

// Clases completas (no interpoladas) para que Tailwind las detecte.
const colors = {
  marino: { text: "fill-marino", stroke: "stroke-rojo", fill: "fill-rojo" },
  blanco: {
    text: "fill-white",
    stroke: "stroke-rojo-400",
    fill: "fill-rojo-400",
  },
} as const;

const { text, stroke, fill } = colors[variant];
const a11y = decorative
  ? { "aria-hidden": "true" as const }
  : { role: "img" as const, "aria-label": label };
---

