---
/**
 * Header sticky con el menú (docs/design/Main.dc.html).
 *
 * - Móvil (<760px): logo de 124px, botón redondo de WhatsApp y hamburguesa,
 *   ambos de 44px. La hamburguesa abre un panel bajo el header con los links
 *   y un botón grande de WhatsApp.
 * - Escritorio (≥760px): logo de 164px, los 5 links y el botón verde.
 *   La fila completa del diseño necesita ~1030px, así que entre 760 y
 *   1023px los espacios se compactan y el botón verde se reduce al mismo
 *   botón redondo de 44px del móvil (con su `aria-label`), para que no haya
 *   scroll horizontal. A 760px la fila compacta mide ~727px, así que cabe
 *   aun con una barra de scroll clásica de 15px (Windows/Linux). Desde
 *   1024px (`lg:`) se ve como en el diseño.
 *   TODO(diseño): validar con diseño la versión compacta de 760–1023px, que
 *   el diseño no define.
 *
 * El cambio entre las dos versiones es solo CSS (`md:` = 760px, ver
 * `--breakpoint-md` en global.css). El script de abajo es el único JS de la
 * página: abre y cierra el panel móvil y ajusta su alto al espacio que queda
 * bajo el header (con la página arriba, el topbar también ocupa pantalla).
 *
 * Sin JavaScript (`@media (scripting: none)`, ver el `<style>` de abajo) la
 * hamburguesa se cambia por dos links: «Abrir menú» va a `#menu-movil`, que
 * se muestra con `:target`, y «Cerrar menú» va a `#barra-movil` (la fila del
 * header, que ya está a la vista, así que no mueve la página). Tocar un link
 * del menú también lo cierra, porque cambia el `:target`.
 *
 * Analytics (issue #12): los botones de WhatsApp de la barra (redondo y
 * verde) llevan `click_whatsapp` con `ubicacion="header"`, y el del panel
 * móvil con `ubicacion="menu_movil"` (atributos de `track()`).
 *
 * Header simplificado (`simple`, para páginas fuera de la landing como el
 * aviso de privacidad, issue #13): solo el logo, que lleva al inicio, y el
 * botón de WhatsApp. Sin links a las secciones ni hamburguesa (y por lo tanto
 * sin menú móvil ni su script). Las alturas son las mismas que las del header
 * completo (64px en móvil, 100px en escritorio), así que `--altura-header`
 * sigue valiendo. Como sobra espacio, el botón verde se ve completo desde
 * 760px.
 */
import WhatsAppIcon from "../assets/icons/whatsapp.svg";
import { menu, ui, wa } from "../data/site";
import { track } from "../lib/analytics";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

interface Props {
  /** Solo logo y WhatsApp (páginas fuera de la landing). */
  simple?: boolean;
}

const { simple = false } = Astro.props;

// Fuera de la landing (p. ej. el aviso de privacidad) los anchors apuntan a
// la página principal.
const enInicio = Astro.url.pathname === "/";
const inicio = enInicio ? "#inicio" : "/";
// Botón redondo de WhatsApp (44px): header móvil y escritorio compacto.
const claseWhatsAppRedondo =
  "flex size-11 shrink-0 items-center justify-center rounded-full bg-whatsapp text-white transition-colors duration-150 hover:bg-whatsapp-hover";
// Hamburguesa (44px). La comparten el botón y su respaldo sin JS.
const claseBotonMenu =
  "flex size-11 items-center justify-center rounded-full border-[1.5px] border-borde bg-white p-0 text-marino";
// Atributos de GA4 de los botones de WhatsApp.
const trackHeader = track("click_whatsapp", { ubicacion: "header" });
const trackMenuMovil = track("click_whatsapp", { ubicacion: "menu_movil" });
const links = menu.map(({ label, href }) => ({
  label,
  href: enInicio ? href : `/${href}`,
}));
---

<header
  class="sticky top-0 z-20 border-b border-borde-suave bg-white"
  data-header
>
  <!-- Móvil -->
  <div
    id="barra-movil"
    class="flex h-16 items-center justify-between gap-3 px-4 md:hidden"
  >
    <a href={inicio} aria-label={ui.irAlInicio} class="block shrink-0">
      <Logo class="w-[124px]" decorative />
    </a>
    <div class="flex items-center gap-2">
      <a
        href={wa.general}
        target="_blank"
        rel="noopener"
        aria-label={ui.cotizarWhatsApp}
        class={claseWhatsAppRedondo}
        {...trackHeader}
      >
        <WhatsAppIcon width={22} height={22} aria-hidden="true" class="block" />
      </a>
      {!simple && (
        <>
          <button
            type="button"
            aria-label={ui.abrirMenu}
            aria-expanded="false"
            aria-controls="menu-movil"
            class:list={["group cursor-pointer", claseBotonMenu]}
            data-menu-toggle
            data-label-abrir={ui.abrirMenu}
            data-label-cerrar={ui.cerrarMenu}
          >
            <Icon name="menu" size={22} class="group-aria-expanded:hidden" />
            <Icon
              name="cerrar"
              size={22}
              class="hidden group-aria-expanded:block"
            />
          </button>
          <!-- Respaldo sin JavaScript (ocultos si hay JS; ver el <style>) -->
          <a
            href="#menu-movil"
            aria-label={ui.abrirMenu}
            class:list={["hidden", claseBotonMenu]}
            data-menu-sin-js="abrir"
          >
            <Icon name="menu" size={22} />
          </a>
          <a
            href="#barra-movil"
            aria-label={ui.cerrarMenu}
            class:list={["hidden", claseBotonMenu]}
            data-menu-sin-js="cerrar"
          >
            <Icon name="cerrar" size={22} />
          </a>
        </>
      )}
    </div>
  </div>

  <!--
    Menú móvil: oculto hasta que se abre (con JS, `data-abierto`; sin JS,
    `:target`). `scroll-mt-16` evita que el `:target` mueva la página.
  -->
  {!simple && (
    <nav
      id="menu-movil"
      aria-label="Menú"
      class="absolute inset-x-0 top-16 hidden max-h-[calc(100dvh-4rem)] scroll-mt-16 flex-col overflow-y-auto overscroll-contain border-b border-borde-suave bg-white px-4 pt-1 pb-5 shadow-[0_18px_32px] shadow-marino/18 max-md:data-abierto:flex"
      data-menu
    >
      {links.map(({ label, href }) => (
        <a
          href={href}
          class="flex min-h-14 items-center justify-between border-b border-borde-tenue font-display text-2xl font-bold text-marino uppercase no-underline"
        >
          {label}
          <Icon
            name="chevron-derecha"
            size={20}
            strokeWidth={2.2}
            class="text-rojo"
          />
        </a>
      ))}
      <Button
        href={wa.general}
        variant="whatsapp"
        external
        block
        class="mt-4"
        {...trackMenuMovil}
      >
        {ui.cotizarWhatsApp}
      </Button>
    </nav>
  )}

  <!-- Escritorio -->
  <div class="hidden items-center justify-between gap-4 py-3.5 page-gutter md:flex lg:gap-6 xl:gap-8">
    <a href={inicio} aria-label={ui.irAlInicio} class="block shrink-0">
      <Logo class="w-[164px]" decorative />
    </a>
    {simple ? (
      <Button
        href={wa.general}
        variant="whatsapp"
        size="sm"
        shape="pill"
        external
        class="whitespace-nowrap"
        {...trackHeader}
      >
        {ui.cotizarWhatsApp}
      </Button>
    ) : (
      <nav
        aria-label="Principal"
        class="flex items-center gap-3 lg:gap-6 xl:gap-8"
      >
        {links.map(({ label, href }) => (
          <a
            href={href}
            class="py-2.5 text-[15px] font-semibold whitespace-nowrap text-grafito no-underline decoration-rojo decoration-2 underline-offset-[6px] hover:underline"
          >
            {label}
          </a>
        ))}
        <a
          href={wa.general}
          target="_blank"
          rel="noopener"
          aria-label={ui.cotizarWhatsApp}
          class:list={[claseWhatsAppRedondo, "lg:hidden"]}
          {...trackHeader}
        >
          <WhatsAppIcon
            width={22}
            height={22}
            aria-hidden="true"
            class="block"
          />
        </a>
        <div class="hidden lg:block">
          <Button
            href={wa.general}
            variant="whatsapp"
            size="sm"
            shape="pill"
            external
            class="whitespace-nowrap"
            {...trackHeader}
          >
            {ui.cotizarWhatsApp}
          </Button>
        </div>
      </nav>
    )}
  </div>
</header>

<style>
  /*
   * Respaldo sin JavaScript: en lugar del botón (que no haría nada) se ven
   * los links a `#menu-movil` / `#barra-movil`, y el panel se abre con
   * `:target`. Este CSS va sin capa, así que gana sobre la clase `hidden` de
   * Tailwind (que vive en la capa `utilities`).
   */
  @media (scripting: none) and (width < 47.5rem) {
    [data-menu-toggle] {
      display: none;
    }
    [data-menu-sin-js="abrir"],
    [data-header]:has(#menu-movil:target) [data-menu-sin-js="cerrar"],
    #menu-movil:target {
      display: flex;
    }
    [data-header]:has(#menu-movil:target) [data-menu-sin-js="abrir"] {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const boton = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = header?.querySelector<HTMLElement>("[data-menu]");

  if (header && boton && panel) {
    const estaAbierto = () => boton.getAttribute("aria-expanded") === "true";
    const etiqueta = (abierto: boolean) =>
      (abierto ? boton.dataset.labelCerrar : boton.dataset.labelAbrir) ?? "";

    // El panel empieza bajo el header, que con la página arriba queda bajo
    // el topbar. El `max-h` de CSS no puede saberlo, así que al abrir (y al
    // hacer scroll o cambiar el tamaño de la ventana) se limita al espacio
    // que queda hasta el borde inferior de la pantalla.
    const ajustarAlto = () => {
      if (!estaAbierto()) return;
      const arriba = panel.getBoundingClientRect().top;
      panel.style.maxHeight = `${Math.max(Math.floor(window.innerHeight - arriba), 0)}px`;
    };

    const cambiar = (abrir: boolean, devolverFoco = false) => {
      boton.setAttribute("aria-expanded", String(abrir));
      boton.setAttribute("aria-label", etiqueta(abrir));
      panel.toggleAttribute("data-abierto", abrir);
      if (abrir) {
        ajustarAlto();
        window.addEventListener("scroll", ajustarAlto, { passive: true });
        window.addEventListener("resize", ajustarAlto);
      } else {
        window.removeEventListener("scroll", ajustarAlto);
        window.removeEventListener("resize", ajustarAlto);
        if (devolverFoco) boton.focus();
      }
    };

    boton.addEventListener("click", () => cambiar(!estaAbierto()));

    // Al tocar cualquier link del header (los del panel, el logo o el botón
    // redondo de WhatsApp) se cierra.
    header.addEventListener("click", (evento) => {
      if (evento.target instanceof Element && evento.target.closest("a")) {
        cambiar(false);
      }
    });

    document.addEventListener("keydown", (evento) => {
      if (evento.key === "Escape" && estaAbierto()) cambiar(false, true);
    });

    // Clic o toque fuera del header. `pointerdown` en lugar de `click`
    // porque iOS Safari no siempre manda `click` al tocar zonas no
    // interactivas.
    document.addEventListener("pointerdown", (evento) => {
      if (
        estaAbierto() &&
        evento.target instanceof Node &&
        !header.contains(evento.target)
      ) {
        cambiar(false);
      }
    });

    // Con teclado: si el foco sale del header (Tab desde el último link),
    // se cierra.
    header.addEventListener("focusout", (evento) => {
      const destino = evento.relatedTarget;
      if (
        estaAbierto() &&
        destino instanceof Node &&
        !header.contains(destino)
      ) {
        cambiar(false);
      }
    });

    // Si la ventana pasa a escritorio con el menú abierto, se cierra para que
    // no reaparezca abierto al volver a móvil.
    window
      .matchMedia("(min-width: 47.5rem)")
      .addEventListener("change", (evento) => {
        if (evento.matches) cambiar(false);
      });
  }
</script>
