---
/**
 * Footer en marino-900: logo blanco con la descripción, sucursales y
 * contacto (`tel:`), y la línea legal con el link al aviso de privacidad.
 */
import { legal, negocio, sucursales, telLink } from "../data/site";
import Logo from "./Logo.astro";

// Año de la compilación: se actualiza con cada deploy.
const anio = new Date().getFullYear();
---

<footer class="bg-marino-900 pt-12 pb-7 text-[15px] text-marino-200 page-gutter">
  <div class="flex flex-wrap justify-between gap-x-16 gap-y-8 page-container">
    <div class="flex-[1_1_260px]">
      <Logo variant="blanco" class="w-[180px]" />
      <p class="mt-4 mb-0 max-w-[300px]">{negocio.descripcion}</p>
    </div>

    <div class="flex-[1_1_220px]">
      <h2 class="mt-0 mb-3 text-[13px] font-bold tracking-[0.12em] text-white uppercase">
        {sucursales.length} sucursales
      </h2>
      {sucursales.map(({ nombre, direccionCorta }) => (
        <p class="m-0 not-last-of-type:mb-3">
          <strong class="text-white">{nombre}</strong>
          <br />
          {direccionCorta}
        </p>
      ))}
    </div>

    <div class="flex-[1_1_220px]">
      <h2 class="mt-0 mb-3 text-[13px] font-bold tracking-[0.12em] text-white uppercase">
        Contacto
      </h2>
      {sucursales.map(({ nombre, telefono }) => (
        <p class="m-0 mb-1">
          <a
            href={telLink(telefono)}
            class="inline-block py-0.5 text-white no-underline hover:underline"
          >
            {nombre} · {telefono}
          </a>
        </p>
      ))}
      <p class="m-0">{negocio.dominio}</p>
    </div>
  </div>

  <div class="mt-10 flex flex-wrap justify-between gap-x-6 gap-y-2 border-t border-marino-700 pt-5 text-[13px] text-marino-300 page-container">
    <p class="m-0">
      {`© ${anio} ${negocio.nombre}`}
      <span aria-hidden="true" class="mx-1.5">
        ·
      </span>
      <a
        href={legal.avisoPrivacidad.href}
        class="inline-block py-0.5 text-marino-300 underline underline-offset-2 hover:text-white"
      >
        {legal.avisoPrivacidad.label}
      </a>
    </p>
    <p class="m-0">{legal.marcas}</p>
  </div>
</footer>
