---
/**
 * Footer en marino-900: logo blanco con la descripción, sucursales y
 * contacto (`tel:`), y la línea legal con el link al aviso de privacidad.
 *
 * Contacto: en escritorio (≥760px) cada línea es un renglón de 22.5px con 8px
 * de margen, como en el diseño (30.5px de una línea a la siguiente). En móvil
 * los links `tel:` miden 44px de alto (área táctil) y losmay.com también, para
 * que los tres renglones queden parejos; el primero sube 8px y el último
 * recupera 10px abajo, para que el texto quede a la distancia del diseño del
 * encabezado y de la línea legal.
 *
 * En la línea legal el link mide 44px y compensa ese alto con márgenes
 * negativos para no mover el layout.
 *
 * Analytics (issue #12): los links `tel:` llevan `click_llamar` con
 * `sucursal` y `ubicacion="footer"`.
 */
import { legal, negocio, sucursales, telLink } from "../data/site";
import { sucursalGa, track } from "../lib/analytics";
import Logo from "./Logo.astro";

// Año de la compilación: se actualiza con cada deploy.
const anio = new Date().getFullYear();

// El link al aviso de privacidad (issue #13) solo se muestra si la página
// existe, para no publicar nunca un link roto.
const hayAvisoPrivacidad =
  Object.keys(import.meta.glob("../pages/aviso-de-privacidad.{astro,md,mdx}"))
    .length > 0;
---

<footer class="foco-sobre-marino bg-marino-900 pt-12 pb-7 text-[15px] text-marino-200 page-gutter">
  <div class="flex flex-wrap justify-between gap-x-16 gap-y-8 page-container">
    <div class="flex-[1_1_260px]">
      <Logo variant="blanco" class="w-[180px]" />
      <p class="mt-4 mb-0 max-w-[300px]">{negocio.descripcion}</p>
    </div>

    <div class="flex-[1_1_220px]">
      <h2 class="mt-0 mb-3 text-[13px] font-bold tracking-[0.12em] text-white uppercase">
        {sucursales.length} sucursales
      </h2>
      {sucursales.map(({ nombre, direccionCorta }) => (
        <p class="m-0 not-last-of-type:mb-3">
          <strong class="text-white">{nombre}</strong>
          <br />
          {direccionCorta}
        </p>
      ))}
    </div>

    <div class="flex-[1_1_220px]">
      <h2 class="mt-0 mb-3 text-[13px] font-bold tracking-[0.12em] text-white uppercase">
        Contacto
      </h2>
      {sucursales.map(({ id, nombre, telefono }) => (
        <p class="m-0 first-of-type:-mt-2 md:mb-2 md:first-of-type:mt-0">
          <a
            href={telLink(telefono)}
            {...track("click_llamar", {
              sucursal: sucursalGa(id),
              ubicacion: "footer",
            })}
            class="inline-flex min-h-11 items-center text-white no-underline hover:underline md:inline md:min-h-0"
          >
            {nombre} · {telefono}
          </a>
        </p>
      ))}
      <p class="m-0 -mb-2.5 flex min-h-11 items-center md:mb-0 md:block md:min-h-0">
        {negocio.dominio}
      </p>
    </div>
  </div>

  <div class="mt-10 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-t border-marino-700 pt-5 text-[13px] text-marino-300 page-container">
    <p class="m-0">
      {`© ${anio} ${negocio.nombre}`}
      {hayAvisoPrivacidad && (
        <>
          <span aria-hidden="true" class="mx-1.5">
            ·
          </span>
          <a
            href={legal.avisoPrivacidad.href}
            class="-my-3 inline-flex min-h-11 items-center text-marino-300 underline underline-offset-2 hover:text-white"
          >
            {legal.avisoPrivacidad.label}
          </a>
        </>
      )}
    </p>
    <p class="m-0">{legal.marcas}</p>
  </div>
</footer>
