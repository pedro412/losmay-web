---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Los May — Cemento Holcim por mayoreo" } = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Fuentes self-hosted. Se precarga la Condensed 800 de los titulares (LCP). -->
    <Font cssVariable="--font-barlow-condensed" preload={[{ weight: 800 }]} />
    <Font cssVariable="--font-barlow" />
  </head>
  <body>
    <slot />
  </body>
</html>
