---
/**
 * Landing de Los May. Las secciones van en el orden de
 * docs/design/Main.dc.html. El ancla `#inicio` la pone BaseLayout.
 *
 * Título, descripción e imagen para compartir: `seo` en `site.ts`. JSON-LD:
 * sucursales (`HardwareStore`) y preguntas frecuentes (`FAQPage`).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { faq } from "../data/site";
import { faqJsonLd } from "../lib/faq-jsonld";
import { negocioJsonLd } from "../lib/jsonld";
import Hero from "../components/sections/Hero.astro";
import ParaQuien from "../components/sections/ParaQuien.astro";
import Pedido from "../components/sections/Pedido.astro";
import Entregas from "../components/sections/Entregas.astro";
import Cemento from "../components/sections/Cemento.astro";
import PorQueLosMay from "../components/sections/PorQueLosMay.astro";
import Sucursales from "../components/sections/Sucursales.astro";
import Faq from "../components/sections/Faq.astro";
import CtaFinal from "../components/sections/CtaFinal.astro";
---

<BaseLayout jsonLd={[negocioJsonLd(), faqJsonLd(faq)]}>
  <Hero />
  <ParaQuien />
  <Pedido />
  <Entregas />
  <Cemento />
  <PorQueLosMay />
  <Sucursales />
  <Faq />
  <CtaFinal />
</BaseLayout>
